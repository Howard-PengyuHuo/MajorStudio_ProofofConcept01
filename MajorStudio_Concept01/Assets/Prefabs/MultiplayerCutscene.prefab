  m_Script: {fileID: 11500000, guid: 5d8644ca1bf4d43089ede4fb29b810f8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Game.Multiplayer.CutsceneCarousel
  content: {fileID: 550078973699538472}
  letterboxBackground: {fileID: 6930316294421151300}
  frameImage: {fileID: 113748764869238881}
  comics:
  - image: {fileID: 2046205921878488515}
    rotatingFrame: {fileID: 910000000000000013}
    narration:
    - text: '[NATIONAL SECURITY ALERT]

        Authorities issue a nationwide warning
        following a high-risk terror threat originating in Hyarinth Town.

        Citizens
        are urged to stay vigilant and report all suspicious activity immediately.'
      duration: 4
    postNarrationHoldDuration: 10
  - image: {fileID: 8889595164076323223}
    rotatingFrame: {fileID: 910000000000000023}
    narration:
    - text: '[CLASSIFIED BRIEFING]

        Intel traces the national threat to the
        cult People''s Community Church, led by John Jonathan ("Heavenly Father").

        Mission:
        Pass their inspection and infiltrate the cult.

        Check "the briefcase"
        for your cover identity.'
      duration: 4
    postNarrationHoldDuration: 3
  - image: {fileID: 6471075292817048755}
    rotatingFrame: {fileID: 1715992635152482917}
    narration:
    - text: Your forged documents and cover identity are printed by "the briefcase."
        Study the files, make the persona your own, and use your wits to fill in
        blanks.
      duration: 4
    postNarrationHoldDuration: 3
  - image: {fileID: 6133893450703939601}
    rotatingFrame: {fileID: 8397590166177964407}
    narration:
    - text: 'Handler Tip:

        Drawing a blank? Shake to ping "the briefcase"
        for live cover intel.

        Stay calm.'
      duration: 4
    postNarrationHoldDuration: 3
  - image: {fileID: 1771709717087299029}
    rotatingFrame: {fileID: 113748764869238881}
    narration:
    - text: 'Touched down at Hyarinth Town local airport

        Time: 18:55'
      duration: 4
    postNarrationHoldDuration: 3
  transitionDuration: 1.2
  rotationMode: 1
  selectionScaleDuration: 0.6
